# Sentinel Environment Variables (Template)
# Copy this file to .env and configure for your local devnet / testnet

# Midnight Blockchain Configuration
VITE_MIDNIGHT_NETWORK=devnet-local
VITE_INDEXER_URL=http://localhost:8088/api/v1/graphql
VITE_PROOF_SERVER_URL=http://localhost:6300
VITE_CONTRACT_ADDRESS=0x7f4a21c99fbd8e32c842b10a9901ef45b23d91ae

# Protocol Parameters
VITE_DEFAULT_AGE_THRESHOLD=18
VITE_APP_NAME=Sentinel
VITE_APP_TAGLINE="Standing guard over what shouldn't be seen."
